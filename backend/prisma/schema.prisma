// ═════════════════════════════════════════════════════════════════════════════
// PROCUREMENT: indent → HOD → store → principal / management → quotation → PO → GRN → bill → payment
// Approval limits live in Organization.settings ("procurement").
// ═════════════════════════════════════════════════════════════════════════════

model Vendor {
  id             String  @id @default(uuid()) @db.UniqueIdentifier
  organizationId String  @db.UniqueIdentifier
  code           String? @db.NVarChar(20) // V-0001 — unique per organization when set
  name           String  @db.NVarChar(200)
  category       String? @db.NVarChar(100)
  gstin          String? @db.NVarChar(15)
  pan            String? @db.NVarChar(10)
  phone          String? @db.NVarChar(20)
  email          String? @db.NVarChar(200)
  address        String? @db.NVarChar(500)
  bankAccount    String? @db.NVarChar(Max) // encrypted JSON { bankName, accountNo, ifsc }
  tdsSection     String  @default("194C") @db.NVarChar(5) // NONE | 194C | 194J | 194I
  isIndividual   Boolean @default(false) // individual / HUF: 194C at 1%
  isActive       Boolean @default(true)

  @@unique([organizationId, name])
}

/// A requisition raised by a teacher (or any staff member) for items they need.
model Indent {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  branchId       String   @db.UniqueIdentifier
  no             String   @db.NVarChar(30) // IND/26-27/0001
  requestedById  String   @db.UniqueIdentifier // User
  requesterName  String   @db.NVarChar(150)
  department     String   @db.NVarChar(100)
  location       String   @db.NVarChar(150)
  purpose        String   @db.NVarChar(1000)
  priority       String   @default("NORMAL") @db.NVarChar(10) // NORMAL | URGENT
  neededBy       DateTime @db.Date
  status         String   @db.NVarChar(25) // PENDING_HOD | PENDING_STORE | PENDING_PRINCIPAL | PENDING_MANAGEMENT | APPROVED_FOR_PURCHASE | PO_RAISED | GOODS_RECEIVED | COMPLETED | REJECTED | CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines  IndentLine[]
  events IndentEvent[]

  @@unique([organizationId, no])
  @@index([organizationId, branchId, status])
}

model IndentLine {
  id              String  @id @default(uuid()) @db.UniqueIdentifier
  organizationId  String  @db.UniqueIdentifier
  indentId        String  @db.UniqueIdentifier
  lineNo          Int
  name            String  @db.NVarChar(200)
  qty             Int
  unit            String  @db.NVarChar(20)
  estRate         Decimal @db.Decimal(12, 2)
  inventoryItemId String? @db.UniqueIdentifier // InventoryItem
  category        String? @db.NVarChar(60) // for a new inventory item
  issuedFromStock Int? // filled at store check
  toPurchase      Int?

  indent Indent @relation(fields: [indentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([indentId, lineNo])
}

/// Every step taken on an indent, in order (the trail shown to everyone involved).
model IndentEvent {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  indentId       String   @db.UniqueIdentifier
  at             DateTime @default(now())
  byUserId       String?  @db.UniqueIdentifier // null = automatic step
  byName         String   @db.NVarChar(150)
  role           String   @db.NVarChar(20) // TEACHER | HOD | STORE | PRINCIPAL | MANAGEMENT | PURCHASE | SYSTEM
  action         String   @db.NVarChar(100)
  remark         String?  @db.NVarChar(1000)

  indent Indent @relation(fields: [indentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([indentId, at])
}

model Quotation {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  indentId       String   @db.UniqueIdentifier
  vendorId       String   @db.UniqueIdentifier
  gstPercent     Decimal  @db.Decimal(5, 2)
  deliveryDays   Int
  validTill      DateTime @db.Date
  notes          String?  @db.NVarChar(500)
  receivedAt     DateTime @default(now())

  lines QuotationLine[]

  @@unique([indentId, vendorId])
}

model QuotationLine {
  id             String  @id @default(uuid()) @db.UniqueIdentifier
  organizationId String  @db.UniqueIdentifier
  quotationId    String  @db.UniqueIdentifier
  lineNo         Int // indent line
  rate           Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([quotationId, lineNo])
}

model PurchaseOrder {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  branchId       String   @db.UniqueIdentifier
  no             String   @db.NVarChar(30) // PO/26-27/0001
  indentId       String   @db.UniqueIdentifier
  vendorId       String   @db.UniqueIdentifier
  quotationId    String   @db.UniqueIdentifier
  orderDate      DateTime @db.Date
  deliveryBy     DateTime @db.Date
  gstPercent     Decimal  @db.Decimal(5, 2)
  status         String   @db.NVarChar(20) // SENT | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  selectionNote  String?  @db.NVarChar(500)
  createdById    String   @db.UniqueIdentifier

  lines PurchaseOrderLine[]

  @@unique([organizationId, no])
  @@index([organizationId, branchId, status])
}

model PurchaseOrderLine {
  id             String  @id @default(uuid()) @db.UniqueIdentifier
  organizationId String  @db.UniqueIdentifier
  poId           String  @db.UniqueIdentifier
  lineNo         Int // indent line
  name           String  @db.NVarChar(200)
  qty            Int
  unit           String  @db.NVarChar(20)
  rate           Decimal @db.Decimal(12, 2)
  received       Int     @default(0)
  accepted       Int     @default(0)

  po PurchaseOrder @relation(fields: [poId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([poId, lineNo])
}

/// Goods receipt note: what arrived against a PO and what passed the quality check.
model GoodsReceipt {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  branchId       String   @db.UniqueIdentifier
  no             String   @db.NVarChar(30) // GRN/26-27/0001
  poId           String   @db.UniqueIdentifier
  receivedOn     DateTime @db.Date
  receivedById   String   @db.UniqueIdentifier
  checkedBy      String   @db.NVarChar(150)
  challanNo      String   @db.NVarChar(60)

  lines GoodsReceiptLine[]

  @@unique([organizationId, no])
}

model GoodsReceiptLine {
  id             String  @id @default(uuid()) @db.UniqueIdentifier
  organizationId String  @db.UniqueIdentifier
  grnId          String  @db.UniqueIdentifier
  lineNo         Int
  received       Int
  accepted       Int
  rejectedReason String? @db.NVarChar(300)

  grn GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([grnId, lineNo])
}

/// The vendor's invoice, checked against PO rate x accepted quantity (three-way match).
model VendorBill {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  branchId       String   @db.UniqueIdentifier
  poId           String   @db.UniqueIdentifier
  vendorId       String   @db.UniqueIdentifier
  billNo         String   @db.NVarChar(60)
  billDate       DateTime @db.Date
  subtotal       Decimal  @db.Decimal(12, 2)
  gst            Decimal  @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  expected       Decimal  @db.Decimal(12, 2)
  status         String   @db.NVarChar(10) // MATCHED | MISMATCH | APPROVED | PAID | ON_HOLD
  note           String?  @db.NVarChar(500)
  enteredById    String   @db.UniqueIdentifier
  createdAt      DateTime @default(now())

  @@unique([vendorId, billNo])
  @@index([organizationId, branchId, status])
}

model VendorPayment {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  branchId       String   @db.UniqueIdentifier
  billId         String   @unique @db.UniqueIdentifier
  vendorId       String   @db.UniqueIdentifier
  paidOn         DateTime @db.Date
  gross          Decimal  @db.Decimal(12, 2)
  tdsSection     String   @db.NVarChar(5) // NONE | 194C | 194J | 194I
  tds            Decimal  @db.Decimal(12, 2)
  net            Decimal  @db.Decimal(12, 2)
  mode           String   @db.NVarChar(10) // NEFT | CHEQUE | UPI
  reference      String   @db.NVarChar(60)
  expenseId      String?  @db.UniqueIdentifier // Expense booked for this payment
  paidById       String   @db.UniqueIdentifier

  @@index([organizationId, branchId, paidOn])
}

/// Petty cash book (imprest): small cash spends and top-ups back to the float.
model PettyCashVoucher {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  branchId       String   @db.UniqueIdentifier
  voucherDate    DateTime @db.Date
  kind           String   @db.NVarChar(6) // SPEND | TOPUP
  purpose        String   @db.NVarChar(300)
  paidTo         String   @db.NVarChar(150)
  category       String?  @db.NVarChar(40)
  amount         Decimal  @db.Decimal(10, 2)
  expenseId      String?  @db.UniqueIdentifier
  approvedById   String   @db.UniqueIdentifier

  @@index([organizationId, branchId, voucherDate])
}

// ═════════════════════════════════════════════════════════════════════════════
// CALENDAR, TRANSFERS, GRADING, ONLINE PAYMENTS
// ═════════════════════════════════════════════════════════════════════════════

/// Holidays and breaks for an academic year (calendars, attendance and timetable skip them).
model Holiday {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  branchId       String?  @db.UniqueIdentifier // null = every branch
  academicYearId String   @db.UniqueIdentifier
  name           String   @db.NVarChar(150)
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  type           String   @db.NVarChar(10) // NATIONAL | VACATION | SCHOOL

  @@index([organizationId, academicYearId, startDate])
}

/// A student moving from one campus to another, kept as history.
model StudentTransfer {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  studentId      String   @db.UniqueIdentifier
  fromBranchId   String   @db.UniqueIdentifier
  toBranchId     String   @db.UniqueIdentifier
  academicYearId String   @db.UniqueIdentifier
  transferDate   DateTime @db.Date
  reason         String?  @db.NVarChar(500)
  approvedById   String   @db.UniqueIdentifier
  createdAt      DateTime @default(now())

  @@index([organizationId, studentId])
}

/// Marks → grade bands used on report cards, e.g. CBSE's A1–E.
model GradingScale {
  id             String  @id @default(uuid()) @db.UniqueIdentifier
  organizationId String  @db.UniqueIdentifier
  name           String  @db.NVarChar(60)
  bands          String  @db.NVarChar(Max) // JSON [{ min, max, grade, point, remark }]
  isDefault      Boolean @default(false)

  @@unique([organizationId, name])
}

/// One online payment attempt (a Razorpay order). A FeePayment is written once it succeeds.
model PaymentOrder {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  branchId       String   @db.UniqueIdentifier
  studentId      String   @db.UniqueIdentifier
  installmentId  String   @db.UniqueIdentifier // FeeInstallment
  amount         Decimal  @db.Decimal(12, 2)
  lateFee        Decimal  @default(0) @db.Decimal(12, 2)
  gateway        String   @db.NVarChar(20) // RAZORPAY
  gatewayOrderId String   @db.NVarChar(100)
  status         String   @db.NVarChar(10) // CREATED | PAID | FAILED | EXPIRED
  feePaymentId   String?  @db.UniqueIdentifier
  createdById    String?  @db.UniqueIdentifier // parent / student who started it
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([gateway, gatewayOrderId])
  @@index([organizationId, studentId])
}

/// Raw payment-gateway webhooks, stored before processing so none is lost or handled twice.
/// Platform table: the organization is only known after the payload is read.
model PaymentWebhookEvent {
  id          String    @id @default(uuid()) @db.UniqueIdentifier
  gateway     String    @db.NVarChar(20)
  eventId     String    @db.NVarChar(100)
  eventType   String    @db.NVarChar(60)
  payload     String    @db.NVarChar(Max)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?   @db.NVarChar(1000)

  @@unique([gateway, eventId])
}

// ═════════════════════════════════════════════════════════════════════════════
// SCHOOL WEBSITE & RECRUITMENT
// ═════════════════════════════════════════════════════════════════════════════
// The school's public website content itself lives in Organization.settings ("website").

/// Demo requests from the SchoolERP product website. Platform table (no organization yet).
model DemoLead {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  name        String   @db.NVarChar(150)
  institution String   @db.NVarChar(200)
  role        String?  @db.NVarChar(60)
  phone       String   @db.NVarChar(20)
  email       String?  @db.NVarChar(200)
  city        String   @db.NVarChar(100)
  campuses    String?  @db.NVarChar(20)
  students    String?  @db.NVarChar(30)
  message     String?  @db.NVarChar(1000)
  status      String   @default("NEW") @db.NVarChar(15) // NEW | CONTACTED | DEMO_DONE | WON | LOST
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

/// A job shown on the website's Careers page.
model JobOpening {
  id               String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId   String   @db.UniqueIdentifier
  branchId         String   @db.UniqueIdentifier
  campus           String?  @db.NVarChar(150) // as shown on the website, e.g. "Junior Wing, Aliganj"
  title            String   @db.NVarChar(150)
  department       String   @db.NVarChar(100)
  category         String   @db.NVarChar(20) // TEACHING | NON_TEACHING | ADMINISTRATION | SUPPORT
  employmentType   String   @db.NVarChar(20) // FULL_TIME | PART_TIME | CONTRACT | GUEST
  vacancies        Int
  qualification    String   @db.NVarChar(300)
  experience       String?  @db.NVarChar(200)
  salary           String?  @db.NVarChar(100) // as shown on the website
  description      String   @db.NVarChar(Max)
  responsibilities String?  @db.NVarChar(Max) // JSON array
  postedOn         DateTime @db.Date
  lastDate         DateTime @db.Date
  isOpen           Boolean  @default(true)

  applications JobApplication[]

  @@index([organizationId, branchId, isOpen])
}

model JobApplication {
  id              String    @id @default(uuid()) @db.UniqueIdentifier
  organizationId  String    @db.UniqueIdentifier
  branchId        String    @db.UniqueIdentifier
  jobOpeningId    String?   @db.UniqueIdentifier // null = general application
  name            String    @db.NVarChar(150)
  email           String    @db.NVarChar(200)
  phone           String    @db.NVarChar(20)
  qualification   String    @db.NVarChar(300)
  experienceYears Int
  currentEmployer String?   @db.NVarChar(150)
  expectedSalary  String?   @db.NVarChar(60)
  coverLetter     String?   @db.NVarChar(Max)
  resumeFileId    String?   @db.UniqueIdentifier // Attachment
  source          String?   @db.NVarChar(30) // where the candidate came from: Website, Referral, Job portal…
  screeningScore  Int?
  screeningNotes  String?   @db.NVarChar(1000)
  status          String    @default("APPLIED") @db.NVarChar(15) // APPLIED | SHORTLISTED | INTERVIEW | SELECTED | REJECTED
  interviewDate   DateTime? @db.Date
  notes           String?   @db.NVarChar(1000)
  appliedAt       DateTime  @default(now())

  jobOpening JobOpening? @relation(fields: [jobOpeningId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, branchId, status])
}

/// Contact, grievance and TC-verification messages sent from the website.
model ContactMessage {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  branchId       String?  @db.UniqueIdentifier
  kind           String   @db.NVarChar(15) // CONTACT | GRIEVANCE | FEEDBACK
  name           String   @db.NVarChar(150)
  phone          String   @db.NVarChar(20)
  email          String?  @db.NVarChar(200)
  subject        String   @db.NVarChar(200)
  message        String   @db.NVarChar(Max)
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId, resolved, createdAt])
}

/// Former students who registered on the website's Alumni page.
model AlumniMember {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  name           String   @db.NVarChar(150)
  batchYear      Int
  email          String   @db.NVarChar(200)
  phone          String?  @db.NVarChar(20)
  occupation     String?  @db.NVarChar(150)
  city           String?  @db.NVarChar(100)
  createdAt      DateTime @default(now())

  @@index([organizationId, batchYear])
}

// ═════════════════════════════════════════════════════════════════════════════
// AUDIT
// ═════════════════════════════════════════════════════════════════════════════

/// Who changed what — required for fees, marks and student records.
model AuditLog {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  branchId       String?  @db.UniqueIdentifier
  userId         String   @db.UniqueIdentifier
  action         String   @db.NVarChar(20) // CREATE | UPDATE | DELETE | LOGIN | EXPORT
  entity         String   @db.NVarChar(60) // FeePayment, Mark…
  entityId       String?  @db.NVarChar(60)
  before         String?  @db.NVarChar(Max)
  after          String?  @db.NVarChar(Max)
  ip             String?  @db.NVarChar(45)
  createdAt      DateTime @default(now())

  @@index([organizationId, entity, createdAt])
}

/// Joining formalities checklist of a new employee.
model OnboardingTask {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  organizationId String    @db.UniqueIdentifier
  staffId        String    @db.UniqueIdentifier
  taskKey        String    @db.NVarChar(40)

  category       String    @db.NVarChar(15) // DOCUMENTS | VERIFICATION | ACCOUNTS | PAYROLL | INDUCTION | OTHER
  sortOrder      Int
  done           Boolean   @default(false)
  doneAt         DateTime?
  doneById       String?   @db.UniqueIdentifier
  note           String?   @db.NVarChar(300)

  @@unique([staffId, taskKey])
}

/// A training programme (induction, skills, compliance…), with its presentation slides.
model Training {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  organizationId String    @db.UniqueIdentifier
  branchId       String    @db.UniqueIdentifier
  title          String    @db.NVarChar(200)
  category       String    @db.NVarChar(15) // INDUCTION | SKILL | COMPLIANCE | SAFETY | OTHER
  description    String?   @db.NVarChar(2000)
  trainerName    String    @db.NVarChar(150)
  trainerStaffId String?   @db.UniqueIdentifier
  mode           String    @db.NVarChar(10) // CLASSROOM | ONLINE
  venue          String?   @db.NVarChar(150)
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  durationHours  Decimal   @db.Decimal(5, 1)
  slides         String?   @db.NVarChar(Max) // JSON [{ title, body }]
  passPercent    Int       @default(60)
  status         String    @default("PLANNED") @db.NVarChar(10) // PLANNED | ONGOING | COMPLETED | CANCELLED
  createdAt      DateTime  @default(now())

  @@index([organizationId, branchId, startDate])
}

/// Question bank of a training (used for the pre-test and the post-test).
model TrainingQuestion {
  id             String @id @default(uuid()) @db.UniqueIdentifier
  organizationId String @db.UniqueIdentifier
  trainingId     String @db.UniqueIdentifier
  sortOrder      Int
  question       String @db.NVarChar(500)
  options        String @db.NVarChar(Max) // JSON array of 2 to 6 options
  answerIndex    Int

  @@index([trainingId])
}

/// A staff member enrolled in a training, with test scores and feedback.
model TrainingEnrollment {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  organizationId String    @db.UniqueIdentifier
  trainingId     String    @db.UniqueIdentifier
  staffId        String    @db.UniqueIdentifier
  preScore       Decimal?  @db.Decimal(5, 2)
  postScore      Decimal?  @db.Decimal(5, 2)
  attended       Boolean   @default(false)
  completedAt    DateTime?
  rating         Int?
  feedback       String?   @db.NVarChar(500)

  @@unique([trainingId, staffId])
}

/// Exit of an employee: separation, exit interview, handover and full & final settlement.
model Separation {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  organizationId String    @db.UniqueIdentifier
  branchId       String    @db.UniqueIdentifier
  staffId        String    @db.UniqueIdentifier
  type           String    @db.NVarChar(15) // RESIGNATION | TERMINATION | RETIREMENT | CONTRACT_END
  noticeDate     DateTime  @db.Date
  lastWorkingDay DateTime  @db.Date
  reason         String    @db.NVarChar(500)
  letter         String?   @db.NVarChar(Max) // resignation letter text
  status         String    @default("REQUESTED") @db.NVarChar(12) // REQUESTED | ACCEPTED | CLEARANCE | SETTLED | WITHDRAWN | REJECTED
  exitInterview  String?   @db.NVarChar(Max) // JSON answers
  handover       String?   @db.NVarChar(Max) // JSON checklist [{ item, owner, done }]
  fnf            String?   @db.NVarChar(Max) // JSON full and final settlement
  expenseId      String?   @db.UniqueIdentifier // payable booked in Accounts
  acceptedById   String?   @db.UniqueIdentifier
  settledAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, branchId, status])
  @@index([staffId])
}


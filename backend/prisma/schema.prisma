  validTill      DateTime  @db.Date
  ctcAnnual      Decimal   @db.Decimal(12, 2)
  breakdown      String    @db.NVarChar(Max) // JSON: the CTC annexure
  status         String    @default("DRAFT") @db.NVarChar(12) // DRAFT | SENT | ACCEPTED | DECLINED | WITHDRAWN
  staffId        String?   @db.UniqueIdentifier // the employee created on joining
  createdById    String    @db.UniqueIdentifier
  createdAt      DateTime  @default(now())
  respondedAt    DateTime?


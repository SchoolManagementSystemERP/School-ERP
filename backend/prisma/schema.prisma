/// Staff attendance, one row per person per day.
model StaffAttendance {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @db.UniqueIdentifier
  branchId       String   @db.UniqueIdentifier
  staffId        String   @db.UniqueIdentifier
  date           DateTime @db.Date
  status         String   @db.NVarChar(10) // PRESENT | ABSENT | HALF_DAY | LEAVE | HOLIDAY | WEEK_OFF

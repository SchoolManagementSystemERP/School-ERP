{
  "name": "school-erp-api",
  "version": "0.1.0",
  "private": true,
  "description": "School ERP REST API — Node.js, Express, Prisma, MS SQL Server",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:db": "tsx scripts/test-db.ts",
    "test:procurement": "tsx scripts/test-procurement.ts",
    "prisma:generate": "prisma generate",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "import:frontend": "tsx scripts/import-frontend-demo.ts",
    "test:academics": "tsx scripts/test-academics.ts",
    "test:finance": "tsx scripts/test-finance.ts",
    "test:communication": "tsx scripts/test-communication.ts",
    "test:website": "tsx scripts/test-website.ts",
    "test:facilities": "tsx scripts/test-facilities.ts",
    "seed:procurement": "tsx scripts/seed-procurement-demo.ts",
    "seed:hr": "tsx scripts/seed-hr-demo.ts",
    "test:hrms": "tsx scripts/test-hrms.ts"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}

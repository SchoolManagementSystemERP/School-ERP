# Copy to .env and fill in. Never commit .env.

# SQL Server connection (Prisma format). Wrap the password in {curly braces} if it contains ; = [ ] { }
DATABASE_URL="sqlserver://localhost:1433;database=school_erp;user=erp_app;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME"

# Encrypts Aadhaar, PAN and bank details before they are stored. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a safe copy: data encrypted with a lost key cannot be recovered.
DATA_ENCRYPTION_KEY="CHANGE_ME"

PORT=4000
# Frontend origin(s) allowed to call the API, comma separated
CORS_ORIGINS="http://localhost:5173"
NODE_ENV=development

# Demo only: lets students/parents record online fee payments without a payment gateway. Must be false in production.
DEMO_PAYMENTS=false
